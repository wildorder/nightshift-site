{
  "name": "nightshift-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The one-page site for Nightshift, at nightshift.wildorder.dev.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "npm run build && vitest run",
    "synth": "npm run build && cdk synth --quiet",
    "verify": "npm run lint && npm test && npm run synth",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.19.0",
    "aws-cdk": "2.1141.0",
    "aws-cdk-lib": "2.269.0",
    "constructs": "10.8.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
